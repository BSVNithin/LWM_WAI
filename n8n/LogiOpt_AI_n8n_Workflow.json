{
  "name": "LogiOpt AI - Shipment Risk Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "logiopt/shipment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "New Shipment Webhook",
